# MongoDB Connection URI
MONGO_URI=your_mongodb_connection_uri

# Nodemailer / Email Service Configuration
EMAIL_USER=your_email_username_or_address
EMAIL_PASS=your_email_app_password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Google Cloud Platform Configuration
GCP_PROJECT_ID=your_gcp_project_id
GCS_BUCKET_NAME=your_gcs_bucket_name

# Vertex AI Settings (Optional overrides)
# GOOGLE_LOCATION=asia-south1
# GEMINI_MODEL=gemini-2.5-flash

# Authentication & Security
JWT_SECRET=your_jwt_secret_key
SUPER_ADMIN_API_KEY=your_super_admin_api_key
SUPER_ADMIN_WEBHOOK_SECRET=your_super_admin_webhook_secret

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_dashboard_password

# Webhook URLs (Optional)
# SUPER_ADMIN_WEBHOOK_URL=your_webhook_url
# SUPER_ADMIN_PLATFORM_ID=yugamc-id

# Server Port
PORT=5000
